{
  "name": "addon-manager",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Left 4 Dead 2 Addons Manager (v2)",
  "author": "akkariin",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win-msvc": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:win-gnu": "npm run build && cargo build --release --target x86_64-pc-windows-gnu -p l4a-tauri --features tauri/custom-protocol",
    "rust:test": "cargo test",
    "server:run": "cargo run -p l4a-server --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "i18next": "^26.7.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
